@using Cogfather.HQ.Domain.Enums

<span class="badge @BadgeClass">@Status</span>

@code {
    [Parameter, EditorRequired]
    public NodeStatus Status { get; set; }

    private string BadgeClass => Status switch
    {
        NodeStatus.Active     => "bg-success",
        NodeStatus.Offline    => "bg-danger",
        NodeStatus.Maintenance => "bg-warning text-dark",
        _                     => "bg-secondary"
    };
}
