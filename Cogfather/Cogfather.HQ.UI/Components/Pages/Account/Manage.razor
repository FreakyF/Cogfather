@page "/account/manage"
@attribute [Authorize]
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> UserManager
@inject Cogfather.HQ.Infrastructure.Identity.TotpService TotpService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Account — Cogfather HQ</PageTitle>

<h1 class="mb-4">Account Settings</h1>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold">Change Password</div>
            <div class="card-body">
                @if (_pwdSuccess)
                {
                    <div class="alert alert-success py-2">Password changed successfully.</div>
                }
                @if (_pwdError is not null)
                {
                    <div class="alert alert-danger py-2">@_pwdError</div>
                }
                <div class="mb-3">
                    <label class="form-label">Current Password</label>
                    <input type="password" class="form-control" @bind="_currentPwd"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input type="password" class="form-control" @bind="_newPwd"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm New Password</label>
                    <input type="password" class="form-control" @bind="_confirmPwd"/>
                </div>
                <button class="btn btn-primary" @onclick="ChangePassword" disabled="@_pwdWorking">
                    @if (_pwdWorking) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Change Password
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold">Two-Factor Authentication (TOTP)</div>
            <div class="card-body">
                @if (_user is null)
                {
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                }
                else if (_user.IsTotpEnabled)
                {
                    <div class="alert alert-success py-2 mb-3">TOTP is enabled.</div>
                    <button class="btn btn-outline-danger" @onclick="DisableTotp">Disable 2FA</button>
                }
                else if (_totpSetupMode)
                {
                    <p class="small text-muted mb-2">Scan the QR code with your authenticator app:</p>
                    <div id="qr-placeholder" class="mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label small">Or enter secret manually:</label>
                        <input type="text" class="form-control font-monospace" readonly value="@_totpSecret"/>
                    </div>
                    @if (_totpError is not null)
                    {
                        <div class="alert alert-danger py-2">@_totpError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Verification Code</label>
                        <input type="text" class="form-control" @bind="_totpVerifyCode" maxlength="6" placeholder="6-digit code"/>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-success" @onclick="VerifyAndEnableTotp">Verify &amp; Enable</button>
                        <button class="btn btn-outline-secondary" @onclick="() => _totpSetupMode = false">Cancel</button>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">Add an extra layer of security with TOTP authentication.</p>
                    <button class="btn btn-primary" @onclick="StartTotpSetup">Enable 2FA</button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private ApplicationUser? _user;

    private string _currentPwd = "";
    private string _newPwd = "";
    private string _confirmPwd = "";
    private bool _pwdWorking;
    private bool _pwdSuccess;
    private string? _pwdError;

    private bool _totpSetupMode;
    private string _totpSecret = "";
    private string _totpQrUri = "";
    private string _totpVerifyCode = "";
    private string? _totpError;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var name = auth.User.Identity?.Name;
        if (name is not null)
            _user = await UserManager.FindByNameAsync(name) ?? await UserManager.FindByEmailAsync(name);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_totpSetupMode && !string.IsNullOrEmpty(_totpQrUri))
            await JS.InvokeVoidAsync("renderQrCode", "qr-placeholder", _totpQrUri);
    }

    private async Task ChangePassword()
    {
        if (_user is null) return;
        _pwdWorking = true;
        _pwdError = null;
        _pwdSuccess = false;

        try
        {
            if (_newPwd != _confirmPwd) { _pwdError = "Passwords do not match."; return; }

            var result = await UserManager.ChangePasswordAsync(_user, _currentPwd, _newPwd);
            if (result.Succeeded)
            {
                _pwdSuccess = true;
                _currentPwd = _newPwd = _confirmPwd = "";
            }
            else
            {
                _pwdError = string.Join("; ", result.Errors.Select(e => e.Description));
            }
        }
        finally
        {
            _pwdWorking = false;
        }
    }

    private void StartTotpSetup()
    {
        _totpSecret = TotpService.GenerateSecret();
        var email = _user?.Email ?? _user?.UserName ?? "user";
        _totpQrUri = TotpService.GenerateQrCodeUri(email, _totpSecret);
        _totpSetupMode = true;
        _totpError = null;
        _totpVerifyCode = "";
    }

    private async Task VerifyAndEnableTotp()
    {
        if (_user is null) return;
        _totpError = null;

        if (!TotpService.VerifyTotp(_totpSecret, _totpVerifyCode))
        {
            _totpError = "Invalid code. Try again.";
            return;
        }

        _user.TotpSecret = _totpSecret;
        _user.IsTotpEnabled = true;
        await UserManager.UpdateAsync(_user);
        _totpSetupMode = false;
    }

    private async Task DisableTotp()
    {
        if (_user is null) return;
        _user.TotpSecret = null;
        _user.IsTotpEnabled = false;
        await UserManager.UpdateAsync(_user);
    }
}
