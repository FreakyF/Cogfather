@page "/orders"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISender Sender
@inject NavigationManager NavManager
@inject IProductionCatalog Catalog
@inject Cogfather.HQ.UI.Services.ConsensusEventService ConsensusEvents
@implements IAsyncDisposable

<PageTitle>Orders — Cogfather HQ</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Production Orders</h1>
    <button class="btn btn-primary" @onclick="OpenIssueModal">Issue Order</button>
</div>

<div class="row g-2 mb-3">
    <div class="col-auto">
        <select class="form-select form-select-sm" @bind="_statusFilter" @bind:after="ApplyFilter">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<ProductionOrderStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (_loading)
        {
            <div class="text-center p-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            </div>
        }
        else if (_filtered.Count == 0)
        {
            <p class="text-muted p-3 mb-0">No orders found.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Recipe</th>
                    <th>Qty</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var order in _paginated)
                {
                    <tr>
                        <td class="font-monospace small text-muted">@order.Id.ToString()[..8]…</td>
                        <td class="font-monospace">@order.RecipeId</td>
                        <td>@order.TargetAmount</td>
                        <td>
                            <span class="badge @StatusBadge(order.Status)">@order.Status</span>
                        </td>
                        <td class="text-muted small">@order.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a href="/orders/@order.Id" class="btn btn-sm btn-outline-secondary">Detail</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            @if (_totalPages > 1)
            {
                <div class="d-flex justify-content-center py-2">
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(_page == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(_page - 1)">‹</button>
                            </li>
                            @for (var i = 1; i <= _totalPages; i++)
                            {
                                var pg = i;
                                <li class="page-item @(_page == pg ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(pg)">@pg</button>
                                </li>
                            }
                            <li class="page-item @(_page == _totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(_page + 1)">›</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

@if (_showIssueModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Issue Production Order</h5>
                    <button type="button" class="btn-close" @onclick="CloseIssueModal"></button>
                </div>
                <div class="modal-body">
                    @if (_issueError is not null)
                    {
                        <div class="alert alert-danger">@_issueError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Recipe</label>
                        <select class="form-select" @bind="_newRecipeId">
                            <option value="">— select recipe —</option>
                            @foreach (var r in _recipes)
                            {
                                <option value="@r.Id">@r.Id</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantity (1–1000)</label>
                        <input type="number" class="form-control" @bind="_newQuantity" min="1" max="1000"/>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseIssueModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SubmitOrder" disabled="@_submitting">
                        @if (_submitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Issue
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<ProductionOrder> _orders = [];
    private List<ProductionOrder> _filtered = [];
    private List<ProductionOrder> _paginated = [];
    private List<Recipe> _recipes = [];
    private string _statusFilter = "";
    private int _page = 1;
    private const int PageSize = 20;
    private int _totalPages;

    private bool _showIssueModal;
    private string _newRecipeId = "";
    private double _newQuantity = 1;
    private bool _submitting;
    private string? _issueError;

    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        ConsensusEvents.OnConsensusReached += HandleConsensus;
        await Refresh();
        var all = await Catalog.GetAllRecipesAsync();
        _recipes = all.ToList();
        _loading = false;
        if (_orders.Any(o => o.Status == ProductionOrderStatus.InProgress))
            StartPolling();
    }

    private void StartPolling()
    {
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await Refresh();
                    StateHasChanged();
                });
                if (!_orders.Any(o => o.Status == ProductionOrderStatus.InProgress))
                    break;
            }
        }
        catch (OperationCanceledException) { }
    }

    private async void HandleConsensus(ConsensusResult _)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await Refresh();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
        _pollCts?.Cancel();
    }

    public ValueTask DisposeAsync()
    {
        ConsensusEvents.OnConsensusReached -= HandleConsensus;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task Refresh()
    {
        var all = await Sender.Send(new GetOrdersQuery());
        _orders = all.OrderByDescending(o => o.CreatedAt).ToList();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filtered = string.IsNullOrEmpty(_statusFilter)
            ? _orders
            : _orders.Where(o => o.Status.ToString() == _statusFilter).ToList();
        _totalPages = (int)Math.Ceiling(_filtered.Count / (double)PageSize);
        GoToPage(1);
    }

    private void GoToPage(int page)
    {
        _page = Math.Max(1, Math.Min(page, Math.Max(1, _totalPages)));
        _paginated = _filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

    private void OpenIssueModal()
    {
        _newRecipeId = "";
        _newQuantity = 1;
        _issueError = null;
        _showIssueModal = true;
    }

    private void CloseIssueModal() => _showIssueModal = false;

    private async Task SubmitOrder()
    {
        if (string.IsNullOrEmpty(_newRecipeId)) { _issueError = "Select a recipe."; return; }
        if (_newQuantity < 1 || _newQuantity > 1000) { _issueError = "Quantity must be 1–1000."; return; }

        _submitting = true;
        _issueError = null;

        try
        {
            var id = await Sender.Send(new IssueProductionOrderCommand(_newRecipeId, _newQuantity));
            _showIssueModal = false;
            await Refresh();
            StartPolling();
            NavManager.NavigateTo($"/orders/{id}");
        }
        catch (Exception ex)
        {
            _issueError = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string StatusBadge(ProductionOrderStatus s) => s switch
    {
        ProductionOrderStatus.Completed  => "bg-success",
        ProductionOrderStatus.Failed     => "bg-danger",
        ProductionOrderStatus.InProgress => "bg-primary",
        ProductionOrderStatus.Cancelled  => "bg-secondary",
        _                                => "bg-warning text-dark"
    };
}
