@page "/inventory"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISender Sender
@inject Cogfather.HQ.UI.Services.ConsensusEventService ConsensusEvents
@implements IDisposable

<PageTitle>Inventory — Cogfather HQ</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">HQ Inventory</h1>
    <span class="badge bg-success">Live</span>
</div>

@if (_loading)
{
    <div class="text-center p-4">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_items.Count == 0)
{
    <div class="alert alert-info">Inventory is empty. Complete production orders to populate it.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                <tr>
                    <th>Item ID</th>
                    <th class="text-end">Quantity</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in _items.OrderBy(i => i.Key))
                {
                    <tr>
                        <td class="font-monospace">@item.Key</td>
                        <td class="text-end">
                            <span class="badge bg-secondary fs-6 px-3">@item.Value.ToString("N0")</span>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot class="table-light">
                <tr>
                    <td class="fw-semibold">Total items</td>
                    <td class="text-end fw-semibold">@_items.Values.Sum().ToString("N0")</td>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private IReadOnlyDictionary<string, double> _items = new Dictionary<string, double>();

    protected override async Task OnInitializedAsync()
    {
        ConsensusEvents.OnConsensusReached += HandleConsensus;
        await LoadInventory();
        _loading = false;
    }

    private async void HandleConsensus(ConsensusResult _)
    {
        try
        {
            await LoadInventory();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async Task LoadInventory()
    {
        var inv = await Sender.Send(new GetInventoryQuery());
        _items = inv.Items;
    }

    public void Dispose()
    {
        ConsensusEvents.OnConsensusReached -= HandleConsensus;
    }
}
