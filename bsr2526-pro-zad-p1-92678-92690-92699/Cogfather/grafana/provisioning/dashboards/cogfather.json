{
  "title": "Cogfather Monitoring",
  "uid": "cogfather-monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["cogfather"],
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Production Orders",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Orders Issued Rate",
      "description": "Production orders issued per second, grouped by recipe",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "auto" },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "rate(cogfather_orders_issued_total[1m])",
          "legendFormat": "{{recipe}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consensus Results",
      "description": "Consensus verdicts per second by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "auto", "stacking": { "group": "A", "mode": "none" } },
          "unit": "ops"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Approved" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Rejected" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Inconclusive" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "sum by (verdict) (rate(cogfather_consensus_total[1m]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Node Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "collapsed": false
    },
    {
      "type": "bargauge",
      "title": "Node Reputation",
      "description": "Current trust score per node (100 = fully trusted, 0 = untrusted)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 80 }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "text": {}
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "cogfather_node_reputation",
          "legendFormat": "{{display_name}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node Heartbeat Rate",
      "description": "Heartbeats received per second per node",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto" },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "rate(cogfather_node_heartbeats_total[1m])",
          "legendFormat": "{{display_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Byzantine Faults",
      "description": "Total Byzantine faults detected per node",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "cogfather_byzantine_faults_total",
          "legendFormat": "{{node_id}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Inventory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 8,
      "collapsed": false
    },
    {
      "type": "bargauge",
      "title": "Inventory Quantities",
      "description": "Current stock level per item in HQ inventory",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {},
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "text": {}
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "cogfather_inventory_quantity",
          "legendFormat": "{{item}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 10,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "description": "Incoming HTTP requests per second by status code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "sum by (code) (rate(http_requests_received_total[1m]))",
          "legendFormat": "HTTP {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Duration (p50 / p95 / p99)",
      "description": "Request latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto" },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cogfather-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 13,
      "collapsed": false
    },
    {
      "type": "logs",
      "title": "Application Logs",
      "description": "Structured logs from HQ and all node workers",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 37 },
      "id": 14,
      "datasource": { "type": "loki", "uid": "cogfather-loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "cogfather-loki" },
          "expr": "{app=~\"cogfather.*\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }
  ]
}
