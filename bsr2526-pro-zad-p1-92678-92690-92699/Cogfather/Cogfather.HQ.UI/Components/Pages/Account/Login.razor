@page "/account/login"
@layout MainLayout
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> UserManager
@inject Cogfather.HQ.Infrastructure.Identity.CaptchaService CaptchaService
@inject Cogfather.HQ.Infrastructure.Identity.TotpService TotpService
@inject Cogfather.HQ.UI.Services.PreauthTokenService PreauthTokens
@inject NavigationManager NavManager

<PageTitle>Sign In — Cogfather HQ</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="card border-0 shadow">
            <div class="card-body p-4">
                <h4 class="card-title mb-4 text-center">Cogfather HQ</h4>

                @if (_loginError is not null)
                {
                    <div class="alert alert-danger py-2">@_loginError</div>
                }

                <EditForm Model="_form" OnValidSubmit="HandleLogin">
                    <div class="mb-3">
                        <label class="form-label">Email / Username</label>
                        <input type="text" class="form-control" @bind="_form.Username"
                               placeholder="admin@cogfather.local"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" class="form-control" @bind="_form.Password"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            CAPTCHA: <strong>@_captchaQuestion</strong>
                        </label>
                        <input type="number" class="form-control @(_captchaFailed ? "is-invalid" : "")"
                               @bind="_captchaInput" placeholder="Answer"/>
                        @if (_captchaFailed)
                        {
                            <div class="invalid-feedback">Incorrect answer, try again.</div>
                        }
                    </div>

                    @if (_showTotp)
                    {
                        <div class="mb-3">
                            <label class="form-label">Authenticator Code</label>
                            <input type="text" class="form-control @(_totpFailed ? "is-invalid" : "")"
                                   @bind="_totpCode" maxlength="6" placeholder="6-digit code"/>
                            @if (_totpFailed)
                            {
                                <div class="invalid-feedback">Invalid or expired code.</div>
                            }
                        </div>
                    }

                    <button type="submit" class="btn btn-primary w-100" disabled="@_submitting">
                        @if (_submitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Sign In
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginForm _form = new();
    private string _captchaQuestion = "";
    private int _captchaAnswer;
    private int _captchaInput;
    private bool _captchaFailed;
    private bool _showTotp;
    private string _totpCode = "";
    private bool _totpFailed;
    private bool _submitting;
    private string? _loginError;
    private ApplicationUser? _pendingTotpUser;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    protected override void OnInitialized()
    {
        (_captchaQuestion, _captchaAnswer) = CaptchaService.GenerateCaptcha();
        if (Error == "expired") _loginError = "Session expired, please sign in again.";
    }

    private async Task HandleLogin()
    {
        _submitting = true;
        _loginError = null;
        _captchaFailed = false;
        _totpFailed = false;

        try
        {
            if (!CaptchaService.VerifyCaptcha(_captchaAnswer, _captchaInput))
            {
                _captchaFailed = true;
                (_captchaQuestion, _captchaAnswer) = CaptchaService.GenerateCaptcha();
                _captchaInput = 0;
                return;
            }

            var user = await UserManager.FindByEmailAsync(_form.Username)
                       ?? await UserManager.FindByNameAsync(_form.Username);

            if (user is null || !await UserManager.CheckPasswordAsync(user, _form.Password))
            {
                _loginError = "Invalid credentials.";
                (_captchaQuestion, _captchaAnswer) = CaptchaService.GenerateCaptcha();
                return;
            }

            if (user.IsTotpEnabled)
            {
                if (!_showTotp)
                {
                    _pendingTotpUser = user;
                    _showTotp = true;
                    return;
                }

                if (string.IsNullOrEmpty(user.TotpSecret) || !TotpService.VerifyTotp(user.TotpSecret, _totpCode))
                {
                    _totpFailed = true;
                    return;
                }
            }

            // Issue a short-lived preauth token; redirect to HTTP endpoint that sets the cookie
            var token = PreauthTokens.CreateToken(user.Id);
            var returnUrl = ReturnUrl ?? "/";
            NavManager.NavigateTo(
                $"/account/do-login?token={token}&returnUrl={Uri.EscapeDataString(returnUrl)}",
                forceLoad: true);
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class LoginForm
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
