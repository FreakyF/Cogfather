<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Only measure coverage for domain and application layers; infrastructure,
               UI, contracts, and worker entry points are integration/hosting concerns. -->
          <Include>[Cogfather.HQ.Application]*,[Cogfather.HQ.Domain]*,[Cogfather.Node.Application]*,[Cogfather.Node.Domain]*</Include>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
